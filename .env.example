# Environment Variables for HunterOS Engage
ENVIRONMENT=development
DEBUG=True

# Security
SECRET_KEY=local_development_secret_key

# Infrastructure connections
DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/hunteros
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# AI
OPENAI_API_KEY=mock-key

# Credential Encryption (P0-1 / E1)
# Generate a secure Fernet key with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
OAUTH_ENCRYPTION_KEY=

# Google OAuth (Gmail & Calendar)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/integrations/oauth/callback

# Microsoft OAuth (Outlook & Calendar)
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common
MICROSOFT_REDIRECT_URI=http://localhost:8000/api/v1/integrations/oauth/callback
