# ─────────────────────────────────────────────────────────────────────────────
# HunterOS Engage — Environment Configuration Template
# Copy this file to .env and fill in all required values.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── OpenAI ───────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o

# ── WhatsApp Business Cloud API ──────────────────────────────────────────────
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=your_custom_verify_token_here
WHATSAPP_API_VERSION=v20.0

# ── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/hunteros

# ── Application ──────────────────────────────────────────────────────────────
APP_ENV=development         # development | production
LOG_LEVEL=INFO              # DEBUG | INFO | WARNING | ERROR
ACTIVE_PROMPT_VERSION=v2    # matches app/prompts/{version}.txt — use v2 for Phase 2 memory

# ── Phase 2: Customer Memory ──────────────────────────────────────────────────
MEMORY_UPDATE_INTERVAL=5    # Update memory every N messages (or on significant fact)
CONVERSATION_IDLE_HOURS=24  # Start a new conversation thread after N hours of inactivity
